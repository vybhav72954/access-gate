# Copy to .env and fill in. Never commit .env.
#
# Which model runs the agent crew with --llm: gemini for development and the demo
# (free tier), claude for the final presentation. Override per run with --provider.
LLM_PROVIDER=gemini

# Gemini via Google's official google-genai SDK. Free tier: create a key in Google AI Studio.
# On the free tier Google may use prompts to improve its products; our case files hold only
# simulated claims, pseudonymous hospital IDs and public district data.
GEMINI_API_KEY=
# Optional overrides (defaults shown): model, fallback on a safety block, requests per minute.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_RPM=10

# Claude via the official Anthropic SDK (claude-opus-5). Paid.
# Without the chosen provider's key, --llm stops with an error; without --llm the
# deterministic rules path runs and every decision is marked degraded=true.
ANTHROPIC_API_KEY=

# Optional: data.gov.in OGD API key, for pulling state admission volumes.
DATA_GOV_IN_API_KEY=

# CrewAI telemetry off for reproducible offline runs.
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true
