# The Access Gate — what must never reach the repository.
# Rule of thumb: secrets, caches, and anything a command regenerates. Evidence the report cites
# (results/*.csv, results/*.json, docs/, data/reference/) IS committed, so the figures can be checked.

# ── secrets ────────────────────────────────────────────────────────────────
# .env holds GEMINI_API_KEY, ANTHROPIC_API_KEY and DATA_GOV_IN_API_KEY. Never commit it.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*_secret*
*.secrets

# ── python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.python-version

# ── tooling caches ─────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── generated run output (regenerate with crew.run / metrics.*) ────────────
out/
out_benchmark/
out_*/
*.log

# out_live/ is the exception. It holds the ten demo scenarios decided by the live nine-agent crew —
# the evidence the test-results deliverable cites, and the front end's only data source. Reproducing
# it needs an API key and a day's quota, and without a key `crew.run --scenarios` degrades to the
# rules and every case comes back with no agents at all. Committed so a clone has the real run.
!out_live/

# Trial evaluation runs only. The published results/ (metrics.json, the sweeps, the benchmark CSVs
# and their run logs) are committed: docs/09 and docs/10 quote them.
results/trial-*/

# Simulated claims are generated in memory and never written beside real data (LLD B-12).
data/synthetic/

# ── scratch ────────────────────────────────────────────────────────────────
scratch/
scratchpad/
tmp/
*.tmp
*.bak
*.orig
*.rej

# ── editors and OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
~$*

# Rendering and tooling leftovers
*.err
node_modules/
.claude/
